# Copia este archivo como .env sólo si necesitas cambiar algo. Todo tiene un valor por defecto.

# Postgres (Neon u otro). Si está vacío, se usa PGlite: un Postgres local guardado en data/pglite.
DATABASE_URL=

# Carpeta de la base local cuando no hay DATABASE_URL
PGLITE_DIR=data/pglite

# Puerto del servidor local
PORT=3001

# Secreto para firmar las sesiones. Si no lo defines, se genera uno y se guarda en la base.
# En producción defínelo con un valor largo y aleatorio.
JWT_SECRET=

# true muestra las cuentas de demo en el login y habilita "Restablecer demo". Pon false para uso real.
DEMO_MODE=true

# true sólo si sirves la app por HTTPS (en Vercel ya está activo)
SECURE_COOKIES=false
