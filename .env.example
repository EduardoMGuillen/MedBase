# Copia este archivo como .env sólo si necesitas cambiar algo. Todo tiene un valor por defecto.

# Postgres (Neon u otro). Si está vacío, se usa PGlite: un Postgres local guardado en data/pglite.
DATABASE_URL=

# Carpeta de la base local cuando no hay DATABASE_URL
PGLITE_DIR=data/pglite

# Puerto del servidor local
PORT=3001

# Secreto para firmar las sesiones. Si no lo defines, se genera uno y se guarda en la base.
# En producción defínelo con un valor largo y aleatorio.
JWT_SECRET=

# true muestra las cuentas de demo en el login y habilita "Restablecer demo". Pon false para uso real.
DEMO_MODE=true

# true sólo si sirves la app por HTTPS (en Vercel ya está activo)
SECURE_COOKIES=false

# Diagnósticos CIE-11 de la OMS (ICD API, gratuita). Crea la cuenta en https://icd.who.int/icdapi y copia
# aquí el client ID y el secreto. Sin ellos, el buscador ofrece los diagnósticos que la clínica ya usó y
# permite escribir uno sin código.
ICD_CLIENT_ID=
ICD_CLIENT_SECRET=
# Si instalas la copia local de la API que distribuye la OMS (Docker o servicio), su dirección; no pide credenciales.
ICD_API_URL=
# Edición de la CIE-11 MMS
ICD_RELEASE=2026-01

# DM1: secreto de la tarea diaria de Vercel que regenera los pacientes demo (vercel.json, 05:00 en Honduras).
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>". Sin él, la tarea no corre.
CRON_SECRET=
