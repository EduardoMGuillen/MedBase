{
  "name": "clinara",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test server/api.test.ts server/inpatient.test.ts server/corrections.test.ts server/corrections2.test.ts server/consultorio.test.ts server/icd.test.ts server/corrections3.test.ts server/demoScenarios.test.ts server/ronda2.test.ts server/caja.test.ts server/tour.test.ts server/dictado.test.ts server/ronda3.test.ts server/demoData.test.ts",
    "db:reset": "tsx server/reset-db.ts",
    "seed:demo": "tsx server/seed-demo.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:neon": "tsx server/reset-db.ts .env.neon.local",
    "superadmin": "tsx server/create-superadmin.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@huggingface/transformers": "4.3.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.59.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
